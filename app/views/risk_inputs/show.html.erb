<% content_for :title, "Risk Inputs - MinRisk" %>

<%= render "shared/page_header",
      title: "Risk Input Configuration",
      subtitle: "Select and apply accuracy driver settings to driver groups and line items." %>

<div class="px-4 py-6 lg:px-8 flex-1 flex flex-col gap-6 max-w-[1600px] mx-auto w-full" data-controller="risk-inputs">
  <%= render "shared/project_selector",
        companies: @companies,
        company: @company,
        project: @project,
        select_id: "risk-inputs-project-select",
        empty_message: "No projects yet. Create one to configure risk inputs.",
        path_for: ->(co, proj) { company_project_risk_inputs_path(co, proj) } %>

  <section data-risk-inputs-target="cardsSection">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <% @driver_types.each do |driver_type| %>
        <%= render "driver_card",
              company: @company,
              project: @project,
              driver_type: driver_type,
              card: @driver_cards.fetch(driver_type),
              filters: @filters %>
      <% end %>
    </div>
  </section>

  <section class="<%= card_class %>">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 <%= card_title_bar_class %>">
      <h2 class="<%= card_title_class %>">Driver Groups / Line Items</h2>
      <%= render "filters",
            company: @company,
            project: @project,
            filters: @filters,
            wbs_options: @wbs_options,
            cost_type_options: @cost_type_options %>
    </div>

    <%= render "driver_group_tree",
          driver_group_rows: @driver_group_rows,
          project: @project,
          selected_group_keys: @selected_group_keys,
          selected_line_item_ids: @selected_line_item_ids %>

    <%= render "summary_footer",
          summary: @summary,
          project: @project,
          driver_groups_with_settings_count: @driver_groups_with_settings_count,
          total_driver_group_count: @total_driver_group_count %>
  </section>
</div>
